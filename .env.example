# Copy this file to .env.local and fill in the values. .env.local is ignored by git.
# Without these, the app runs in demo mode and keeps trips in the browser only.

# The Supabase API address (must be https for the live site).
EXPO_PUBLIC_SUPABASE_URL=https://roadtrip-api.thejumpvault.com

# The public "anon" key: ANON_KEY in /srv/apps/supabase/.env on the server. It ships in the
# website by design; the tunnel only lets it reach Roadbook's functions.
# Never put SERVICE_ROLE_KEY or SUPABASE_SECRET_KEY here.
EXPO_PUBLIC_SUPABASE_KEY=

# The live site, used for share links in the phone apps. The website uses its own address.
EXPO_PUBLIC_SITE_URL=https://roadtrip.thejumpvault.com
